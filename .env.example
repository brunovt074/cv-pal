# All of this is optional - `cvpal init` writes ~/.config/cvpal/config.toml,
# which covers everything below. Anything set here (or in a real .env file,
# gitignored) overrides the config file. Useful for quick overrides without
# re-running `cvpal init`.

# Agent provider (see AGENTS.md Architecture section) - any name registered in
# infrastructure/agents/registry.py
CVPAL_AGENT=opencode

# Per-provider overrides (optional - defaults live in infrastructure/agents/cli/*.py)
# OPENCODE_BIN=opencode
# OPENCODE_MODEL=opencode-go/deepseek-v4-pro
# CLAUDE_CODE_BIN=claude
# CLAUDE_CODE_MODEL=sonnet

# Paths
CV_RAW_DIR=./cv-raw
# CV_DATA_DIR=~/.local/share/cvpal   # override if you want the knowledge base stored elsewhere

# Identity (normally set via `cvpal init` -> config.toml, shown here as the
# escape hatch every one of these fields has)
# CVPAL_USER_NAME=
# CVPAL_USER_SLUG=
# CVPAL_PHONE=
# CVPAL_LINKEDIN=
# CVPAL_GITHUB=
